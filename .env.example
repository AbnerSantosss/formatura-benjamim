# Copie para .env e preencha. Nunca commite o .env.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3180
DATABASE_URL=postgresql://benjamim:benjamim@localhost:5432/benjamim

# openssl rand -hex 32 (guarde CPF_ENCRYPTION_KEY em cofre: perder = perder os CPFs)
AUTH_SECRET=
CPF_ENCRYPTION_KEY=
CRON_SECRET=

# Gateway ativo: mercadopago | fastpay | ironpay | demo (demo só em dev)
PAYMENT_GATEWAY=demo
DEMO_MODE=true
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_API_FLAVOR=orders
FASTPAY_API_URL=
FASTPAY_API_KEY=
FASTPAY_WEBHOOK_SECRET=
IRONPAY_API_URL=
IRONPAY_API_KEY=
IRONPAY_WEBHOOK_SECRET=

# E-mail (SMTP). Gmail: smtp.gmail.com, 587, SMTP_SECURE=false, senha de app de 16 letras.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BENJAMIM ABC <seu-email@gmail.com>"
MAIL_REPLY_TO=

# Seed inicial (depois vive no banco)
CAMPAIGN_GOAL_CENTS=2500000
CAMPAIGN_COSTS_CENTS=0
INSTAGRAM_FATHER_URL=
INSTAGRAM_MOTHER_URL=
LOG_LEVEL=info

# Admin inicial (usado por `npm run admin:create`; a senha é temporária e o sistema exige troca no primeiro login)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
